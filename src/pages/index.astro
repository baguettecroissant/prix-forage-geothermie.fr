---
import Layout from "../layouts/Layout.astro";
import { ViteUnDevisWidget } from "../components/affiliation/ViteUnDevisWidget";
import { getAllGuides } from "../data/guides";
import {
  IconArrowRight,
  IconCheck,
  IconStar,
  IconMapPin,
  IconClock,
  IconShieldCheck,
  IconRulerMeasure,
  IconMountain,
  IconBackhoe,
  IconChartBar,
} from "@tabler/icons-react";

export const prerender = true;

const guides = getAllGuides().slice(0, 4);
---

<Layout title="Prix Forage Géothermie — Tarifs, Devis et Coûts 2026">
  <div class="flex flex-col min-h-screen">
    {/* Hero Section — FORAGE FOCUS */}
    <section class="relative bg-gradient-to-br from-slate-900 via-blue-950 to-slate-900 border-b border-slate-700 py-20 lg:py-0 lg:h-[600px] flex items-center overflow-hidden">
      <div class="absolute inset-0 opacity-10">
        <div class="absolute top-10 left-[10%] w-3 h-3 bg-blue-400 rounded-full animate-bounce" style="animation-delay: 0s; animation-duration: 3s;"></div>
        <div class="absolute top-20 left-[30%] w-2 h-2 bg-cyan-300 rounded-full animate-bounce" style="animation-delay: 0.5s; animation-duration: 2.5s;"></div>
        <div class="absolute top-16 right-[20%] w-4 h-4 bg-blue-500 rounded-full animate-bounce" style="animation-delay: 1s; animation-duration: 3.5s;"></div>
      </div>

      <div class="max-w-7xl mx-auto px-4 relative z-10">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div class="max-w-2xl">
            <div class="inline-flex items-center gap-2 bg-blue-50/20 border border-blue-400/30 text-blue-200 px-4 py-1.5 rounded-full text-sm font-medium mb-6">
              <IconStar class="h-4 w-4 fill-blue-400 text-blue-400" />
              <span>Barème Forage 2026 — Mis à jour</span>
            </div>

            <h1 class="text-4xl md:text-6xl font-extrabold text-white mb-6 tracking-tight leading-tight font-heading">
              Prix du Forage{" "}
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent to-cyan-400">Géothermique</span>
            </h1>

            <p class="text-xl text-slate-200 mb-8 leading-relaxed">
              De 40€ à 120€ le mètre linéaire selon votre sous-sol. Comparez les tarifs de forage dans votre commune et estimez le coût total de votre installation.
            </p>

            <div class="flex flex-col sm:flex-row gap-4">
              <a href="/devis" class="inline-flex items-center justify-center bg-accent hover:bg-blue-700 text-white text-lg px-8 h-14 rounded-xl shadow-lg shadow-blue-900/20 transition-all transform hover:scale-105 font-bold">
                Estimer mon forage
                <IconArrowRight class="ml-2 h-5 w-5" />
              </a>
              <div class="flex items-center gap-3 text-slate-300 px-4">
                <div class="text-sm">
                  <span class="font-bold text-white block">80-200 m</span>
                  profondeur standard
                </div>
              </div>
            </div>
          </div>

          <div class="hidden lg:block relative">
            <div class="relative rounded-2xl overflow-hidden shadow-2xl border border-white/10 transform rotate-2 hover:rotate-0 transition-transform duration-500">
              <div class="w-full h-[400px] relative flex items-center justify-center bg-gradient-to-br from-slate-800 to-blue-950">
                <div class="text-center p-8 relative z-10">
                  <div class="w-24 h-24 mx-auto mb-6 rounded-full bg-gradient-to-br from-blue-500/30 to-cyan-500/30 border-2 border-blue-400/50 flex items-center justify-center">
                    <IconBackhoe class="h-12 w-12 text-blue-400" />
                  </div>
                  <div class="text-white font-heading font-bold text-2xl mb-2">40–120€/ml</div>
                  <div class="text-slate-300">Prix du forage au mètre</div>
                  <div class="text-slate-400 text-sm mt-1">Selon le type de sous-sol</div>
                  <div class="mt-6 flex justify-center gap-4">
                    <div class="bg-slate-700/50 p-3 rounded-lg text-center">
                      <div class="text-blue-400 font-bold text-lg">30-40%</div>
                      <div class="text-slate-400 text-xs">du budget total</div>
                    </div>
                    <div class="bg-slate-700/50 p-3 rounded-lg text-center">
                      <div class="text-cyan-400 font-bold text-lg">50+ ans</div>
                      <div class="text-slate-400 text-xs">durée des sondes</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="absolute -bottom-6 -left-6 bg-white p-4 rounded-xl shadow-xl flex items-center gap-4 animate-bounce" style="animation-duration: 3s;">
              <div class="bg-blue-100 p-2 rounded-full">
                <IconCheck class="h-6 w-6 text-blue-600" />
              </div>
              <div>
                <p class="text-sm font-bold text-slate-900">Foreur QualiForage</p>
                <p class="text-xs text-slate-500">Certification vérifiée</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Trust Bar */}
    <section class="bg-white border-b border-slate-100 py-6">
      <div class="max-w-7xl mx-auto px-4">
        <div class="flex flex-wrap justify-center md:justify-between items-center gap-6 text-slate-500 text-sm font-medium uppercase tracking-wider">
          <div class="flex items-center gap-2"><IconShieldCheck class="h-5 w-5 text-secondary" /> Foreurs QualiForage</div>
          <div class="flex items-center gap-2"><IconRulerMeasure class="h-5 w-5 text-secondary" /> Prix au mètre garanti</div>
          <div class="flex items-center gap-2"><IconClock class="h-5 w-5 text-secondary" /> Devis détaillé sous 48h</div>
          <div class="flex items-center gap-2"><IconMountain class="h-5 w-5 text-secondary" /> Étude géologique incluse</div>
        </div>
      </div>
    </section>

    {/* Prix par type de sol */}
    <section class="py-20 bg-bg">
      <div class="max-w-7xl mx-auto px-4">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-3xl font-bold text-primary mb-4 font-heading">Coût du forage selon votre sous-sol</h2>
          <p class="text-slate-600 text-lg">
            Le prix au mètre linéaire varie du simple au triple selon la géologie de votre terrain.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-6">
          {[
            { type: "Terrain sédimentaire", desc: "Calcaire, craie, marne — Bassin parisien, Aquitaine, Jura", prix: "40 – 60€/ml", total: "6 400 – 9 600€", icon: IconMountain, color: "bg-green-50 border-green-200", badge: "Forage facile" },
            { type: "Terrain granitique", desc: "Socle ancien — Bretagne, Massif central, Vosges", prix: "60 – 90€/ml", total: "9 600 – 14 400€", icon: IconBackhoe, color: "bg-amber-50 border-amber-200", badge: "Forage modéré" },
            { type: "Terrain basaltique", desc: "Roche volcanique — Auvergne, Cantal, Ardèche", prix: "80 – 120€/ml", total: "12 800 – 19 200€", icon: IconChartBar, color: "bg-red-50 border-red-200", badge: "Forage complexe" },
          ].map((item) => (
            <div class={`p-8 rounded-2xl shadow-sm border hover:shadow-lg transition-shadow ${item.color}`}>
              <div class="w-14 h-14 bg-white rounded-xl flex items-center justify-center mb-6 shadow-sm">
                <item.icon class="h-7 w-7 text-secondary" />
              </div>
              <span class="inline-block text-xs font-bold px-2 py-1 rounded bg-white text-secondary mb-3">{item.badge}</span>
              <h3 class="text-xl font-bold text-primary mb-2 font-heading">{item.type}</h3>
              <p class="text-sm text-slate-600 mb-4">{item.desc}</p>
              <p class="font-mono text-lg font-bold text-secondary">{item.prix}</p>
              <p class="text-xs text-slate-500 mt-1">Budget forage seul (2 × 80 m) : {item.total}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Profondeur et dimensionnement */}
    <section class="py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <h2 class="text-3xl font-bold text-primary mb-4 font-heading">Quelle profondeur de forage pour votre maison ?</h2>
          <p class="text-slate-600 text-lg">
            La profondeur dépend de la surface habitable, de l'isolation et de la puissance thermique extractible du sous-sol (40 à 60 W/m).
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-100 hover:shadow-md transition-shadow">
            <div class="w-14 h-14 bg-blue-50 rounded-xl flex items-center justify-center mb-6">
              <IconRulerMeasure class="h-7 w-7 text-blue-600" />
            </div>
            <h3 class="text-xl font-bold text-primary mb-3 font-heading">Maison 80 m² — Bien isolée</h3>
            <p class="text-slate-600 mb-4">
              Besoin : 5 kW. <strong>1 forage de 100 m</strong> suffit. Budget forage : 4 000 à 7 000€. Installation complète : 15 000 à 20 000€.
            </p>
            <p class="font-mono text-secondary font-bold">100 m de profondeur</p>
          </div>
          <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-100 hover:shadow-md transition-shadow">
            <div class="w-14 h-14 bg-amber-50 rounded-xl flex items-center justify-center mb-6">
              <IconRulerMeasure class="h-7 w-7 text-accent" />
            </div>
            <h3 class="text-xl font-bold text-primary mb-3 font-heading">Maison 120 m² — Standard</h3>
            <p class="text-slate-600 mb-4">
              Besoin : 8 kW. <strong>2 forages de 80 m</strong> ou 1 forage de 150 m. Budget forage : 6 400 à 14 400€. Installation complète : 20 000 à 28 000€.
            </p>
            <p class="font-mono text-secondary font-bold">160 m (2 × 80 m)</p>
          </div>
          <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-100 hover:shadow-md transition-shadow">
            <div class="w-14 h-14 bg-red-50 rounded-xl flex items-center justify-center mb-6">
              <IconRulerMeasure class="h-7 w-7 text-red-500" />
            </div>
            <h3 class="text-xl font-bold text-primary mb-3 font-heading">Maison 180 m² — Ancienne</h3>
            <p class="text-slate-600 mb-4">
              Besoin : 12 kW. <strong>2 forages de 130 m</strong> ou 3 forages de 90 m. Budget forage : 10 400 à 19 200€. Installation complète : 25 000 à 35 000€.
            </p>
            <p class="font-mono text-secondary font-bold">260 m (2 × 130 m)</p>
          </div>
        </div>
      </div>
    </section>

    {/* SEO Content Block */}
    <section class="py-20 bg-bg border-y border-slate-100">
      <div class="max-w-7xl mx-auto px-4 flex flex-col lg:flex-row gap-16">
        <div class="lg:w-2/3 prose prose-lg prose-slate">
          <h2 class="text-3xl font-extrabold text-primary not-prose mb-8 font-heading">
            Comment est calculé le prix d'un forage géothermique ?
          </h2>
          <p>
            Le coût d'un forage géothermique en France dépend de <strong>4 facteurs principaux</strong> : la nature du sous-sol (sédimentaire, granitique ou volcanique), la profondeur requise (80 à 200 m), l'accessibilité du chantier (passage foreuse, évacuation déblais) et la région (tarifs foreurs locaux).
          </p>
          <p>
            Le forage représente <strong>30 à 40% du budget total</strong> d'une installation géothermique. Pour une maison standard de 120 m², comptez 160 mètres linéaires de forage (2 puits de 80 m), soit un budget forage de <strong>6 400€ à 14 400€ TTC</strong> selon la géologie.
          </p>
          <ul class="not-prose grid gap-4 my-8">
            <li class="flex items-center gap-4 p-4 bg-white rounded-lg border border-slate-200">
              <span class="font-bold text-primary min-w-[180px]">Mobilisation foreuse</span>
              <span class="text-slate-600">Forfait de <strong>1 500 à 3 000€</strong> pour le transport et la mise en place de la foreuse sur chantier.</span>
            </li>
            <li class="flex items-center gap-4 p-4 bg-white rounded-lg border border-slate-200">
              <span class="font-bold text-primary min-w-[180px]">Forage + cimentation</span>
              <span class="text-slate-600">De <strong>40 à 120€ par mètre</strong> selon le sous-sol. Comprend le forage, la pose des sondes et le scellement au coulis de ciment.</span>
            </li>
            <li class="flex items-center gap-4 p-4 bg-white rounded-lg border border-slate-200">
              <span class="font-bold text-primary min-w-[180px]">Test de réponse thermique</span>
              <span class="text-slate-600">Optionnel mais recommandé : <strong>2 000 à 4 000€</strong>. Mesure la conductivité thermique réelle du sous-sol pour optimiser le dimensionnement.</span>
            </li>
          </ul>
          <p>
            <strong>Astuce budget :</strong> consultez la carte géologique du BRGM (<a href="https://infoterre.brgm.fr" target="_blank" rel="noopener noreferrer" class="text-secondary font-medium underline">infoterre.brgm.fr</a>) pour anticiper la nature de votre sous-sol avant de demander des devis. Un sol calcaire peut diviser le budget forage par deux par rapport à du basalte.
          </p>
        </div>

        <div class="lg:w-1/3 space-y-8">
          <div class="bg-blue-50 border border-blue-100 p-6 rounded-2xl">
            <h3 class="font-bold text-blue-900 mb-4 flex items-center gap-2 font-heading">
              <IconBackhoe class="h-5 w-5" /> Besoin d'un devis forage ?
            </h3>
            <p class="text-sm text-blue-800 mb-4">
              Recevez <strong>3 devis détaillés</strong> de foreurs QualiForage dans votre département. Prix au mètre garanti.
            </p>
            <a href="/devis" class="block w-full bg-accent hover:bg-blue-700 text-white font-bold py-3 px-6 rounded-lg text-center transition-colors">
              Comparer les foreurs
            </a>
          </div>

          <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
            <div class="p-6 border-b border-slate-100 bg-slate-50">
              <h3 class="font-bold text-primary flex items-center gap-2 font-heading">
                <IconArrowRight class="h-5 w-5 text-secondary" /> Guides Forage
              </h3>
            </div>
            <div class="divide-y divide-slate-100">
              {guides.map((guide) => (
                <a href={`/guides/${guide.slug}`} class="flex gap-4 p-4 hover:bg-slate-50 transition-colors group">
                  <div class="flex-1">
                    <h4 class="text-sm font-bold text-primary group-hover:text-secondary transition-colors line-clamp-2 mb-1">
                      {guide.title}
                    </h4>
                  </div>
                </a>
              ))}
            </div>
            <div class="p-4 bg-slate-50 text-center">
              <a href="/guides" class="text-sm font-medium text-secondary hover:text-secondary/80">
                Voir tous les guides →
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Departments Grid */}
    <section class="py-20 bg-slate-900 text-white">
      <div class="max-w-7xl mx-auto px-4">
        <div class="flex flex-col md:flex-row justify-between items-end mb-12">
          <div class="max-w-2xl">
            <h2 class="text-3xl font-bold mb-4 font-heading">Prix du forage dans votre ville</h2>
            <p class="text-slate-400">
              Le tarif au mètre varie selon la géologie locale. Sélectionnez votre commune pour obtenir une estimation personnalisée.
            </p>
          </div>
          <a href="/annuaire" class="hidden md:inline-flex items-center text-secondary hover:text-blue-400 font-medium mt-4 md:mt-0">
            Toutes les villes <IconArrowRight class="ml-2 h-4 w-4" />
          </a>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
          <a href="/geothermie/paris-75001" class="dept-card">Paris (75)</a>
          <a href="/geothermie/lyon-69001" class="dept-card">Lyon (69)</a>
          <a href="/geothermie/marseille-13001" class="dept-card">Marseille (13)</a>
          <a href="/geothermie/bordeaux-33000" class="dept-card">Bordeaux (33)</a>
          <a href="/geothermie/toulouse-31000" class="dept-card">Toulouse (31)</a>
          <a href="/geothermie/nantes-44000" class="dept-card">Nantes (44)</a>
          <a href="/geothermie/lille-59000" class="dept-card">Lille (59)</a>
          <a href="/geothermie/strasbourg-67000" class="dept-card">Strasbourg (67)</a>
          <a href="/geothermie/nice-06000" class="dept-card">Nice (06)</a>
          <a href="/geothermie/montpellier-34000" class="dept-card">Montpellier (34)</a>
          <a href="/geothermie/rennes-35000" class="dept-card">Rennes (35)</a>
          <a href="/geothermie/grenoble-38000" class="dept-card">Grenoble (38)</a>
        </div>

        <div class="mt-8 text-center md:hidden">
          <a href="/annuaire" class="text-secondary font-medium">Voir toutes les villes →</a>
        </div>
      </div>
    </section>

    {/* FAQ */}
    <section class="py-20 bg-white">
      <div class="max-w-3xl mx-auto px-4">
        <h2 class="text-3xl font-bold text-center text-primary mb-12 font-heading">Questions Fréquentes sur le Forage</h2>

        <div class="space-y-4">
          {[
            { q: "Combien coûte un forage géothermique au mètre ?", a: "Le prix du forage varie de 40€/ml en terrain sédimentaire (calcaire, craie) à 120€/ml en terrain basaltique (roche volcanique). Pour une maison standard de 120 m² nécessitant 160 ml de forage, le budget forage seul se situe entre 6 400€ et 19 200€ TTC." },
            { q: "Quelle profondeur de forage pour ma maison ?", a: "La règle simplifiée : comptez environ 20 mètres de sonde par kW de besoin. Pour une maison de 80 m² bien isolée (5 kW) : 1 forage de 100 m. Pour 120 m² (8 kW) : 2 forages de 80 m. Pour 180 m² mal isolée (12 kW) : 2 forages de 130 m." },
            { q: "Faut-il une autorisation pour forer ?", a: "Oui, tout forage de plus de 10 m nécessite une déclaration auprès de la DREAL via georisques.gouv.fr. Au-delà de 100 m, une déclaration renforcée avec étude d'impact est requise. Délai : 1 à 3 mois. Votre foreur se charge des formalités." },
          ].map((faq) => (
            <details class="group bg-white rounded-lg border border-slate-200 overflow-hidden">
              <summary class="flex cursor-pointer items-center justify-between p-5 font-semibold text-primary group-hover:bg-slate-50 transition-colors text-lg">
                {faq.q}
                <span class="text-slate-400 group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <div class="p-5 pt-0 text-slate-600 leading-relaxed">
                {faq.a}
              </div>
            </details>
          ))}
        </div>
        <div class="mt-8 text-center">
          <a href="/faq" class="inline-flex items-center text-secondary font-medium hover:underline">
            Toutes les questions sur le forage <IconArrowRight class="ml-2 h-4 w-4" />
          </a>
        </div>
      </div>
    </section>

    {/* CTA Footer */}
    <section class="py-20 bg-gradient-to-r from-blue-900 to-slate-900 text-white text-center">
      <div class="max-w-4xl mx-auto px-4">
        <h2 class="text-3xl md:text-5xl font-bold mb-6 font-heading">Estimez le coût de votre forage</h2>
        <p class="text-xl text-blue-100 mb-10">
          Comparez les devis de foreurs certifiés QualiForage dans votre département. Prix au mètre garanti.
        </p>
        <a href="/devis" class="inline-flex items-center bg-white text-blue-900 hover:bg-slate-100 text-xl px-12 py-4 rounded-full shadow-2xl transition-transform hover:scale-105 font-bold">
          Obtenir mes devis forage
          <IconArrowRight class="ml-2 h-6 w-6" />
        </a>
        <p class="mt-6 text-sm text-blue-200 opacity-80">
          Gratuit • Sans engagement • Étude géologique offerte
        </p>
      </div>
    </section>
  </div>
</Layout>
