---
import Layout from "../../layouts/Layout.astro";
import { ViteUnDevisWidget } from "../../components/affiliation/ViteUnDevisWidget";
import { getAllBrands } from "../../data/brands";
import { IconCheck, IconFlame } from "@tabler/icons-react";

export const prerender = true;

export async function getStaticPaths() {
  const allBrands = getAllBrands();
  return allBrands.map((brand) => ({
    params: { slug: brand.slug },
    props: { brand },
  }));
}

const { slug } = Astro.params;
const { brand } = Astro.props;

const allBrands = getAllBrands();
const otherBrands = allBrands.filter((b) => b.slug !== slug);
---

<Layout 
  title={`${brand.name} Géothermie — Avis, Prix et Modèles 2026`} 
  description={brand.description}
  canonical={`https://www.prix-forage-geothermie.fr/marques/${slug}`}
>
  <div class="bg-bg min-h-screen py-16 px-4">
    <div class="max-w-7xl mx-auto">
      <nav class="text-sm text-stone-500 mb-8 max-w-4xl">
        <a href="/" class="hover:text-secondary">Accueil</a>
        <span class="mx-2">›</span>
        <a href="/marques" class="hover:text-secondary">Marques</a>
        <span class="mx-2">›</span>
        <span class="text-primary font-medium">{brand.name}</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 items-start">
        <article class="lg:col-span-2 bg-white rounded-2xl shadow-sm border border-stone-100 p-8 md:p-12">
          <div class="flex items-center gap-4 mb-6">
            <span class="inline-block text-xs font-bold px-3 py-1 rounded-full bg-warm text-secondary">{brand.gamme}</span>
            <span class="text-sm text-stone-400">{brand.origin}</span>
          </div>

          <h1 class="font-heading text-3xl md:text-4xl font-bold text-primary mb-6">{brand.name} — PAC Géothermique</h1>

          <p class="text-lg text-stone-700 leading-relaxed mb-8">{brand.content}</p>

          <div class="grid md:grid-cols-2 gap-6 mb-8">
            <div class="bg-stone-50 p-6 rounded-xl border border-stone-200">
              <h3 class="font-heading font-bold text-primary mb-4">Points forts</h3>
              <ul class="space-y-3">
                {brand.points_forts.map((point) => (
                  <li class="flex items-start gap-2 text-sm text-stone-700">
                    <IconCheck class="h-5 w-5 text-green-600 shrink-0 mt-0.5" />
                    {point}
                  </li>
                ))}
              </ul>
            </div>
            <div class="space-y-4">
              <div class="bg-stone-50 p-6 rounded-xl border border-stone-200">
                <h3 class="font-heading font-bold text-primary mb-3">Modèles phares</h3>
                <ul class="space-y-2">
                  {brand.modeles_phares.map((model) => (
                    <li class="text-sm text-stone-700 font-medium">• {model}</li>
                  ))}
                </ul>
              </div>
              <div class="bg-warm p-6 rounded-xl border border-secondary/20">
                <div class="text-sm text-stone-600 space-y-2">
                  <div><strong class="text-primary">Budget PAC seule :</strong> {brand.budget}</div>
                  <div><strong class="text-primary">Garantie :</strong> {brand.garantie}</div>
                  <div><strong class="text-primary">Certifications :</strong> {brand.certification}</div>
                </div>
              </div>
            </div>
          </div>
        </article>

        <aside class="lg:col-span-1 sticky top-28 space-y-8">
          <ViteUnDevisWidget client:load />

          <div class="bg-white border border-stone-200 rounded-2xl shadow-sm overflow-hidden">
            <div class="p-5 border-b border-stone-100 bg-stone-50">
              <h4 class="font-bold text-primary text-sm font-heading flex items-center gap-2 uppercase tracking-wide">
                <IconFlame class="h-5 w-5 text-secondary" /> Autres marques
              </h4>
            </div>
            <div class="divide-y divide-stone-100">
              {otherBrands.map((b) => (
                <a href={`/marques/${b.slug}`} class="flex justify-between items-center p-4 hover:bg-stone-50 transition-colors group">
                  <span class="text-sm font-medium text-primary group-hover:text-secondary transition-colors">{b.name}</span>
                  <span class="text-xs text-stone-400">{b.gamme}</span>
                </a>
              ))}
            </div>
          </div>
        </aside>
      </div>
    </div>
  </div>
</Layout>
